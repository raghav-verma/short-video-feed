*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ---------------------------------------------------------------------------
# Secrets: never commit keys, tokens or signing material.
# Runtime keys are passed with --dart-define or --dart-define-from-file, and the
# real files stay local. Only the *.example templates are tracked.
# ---------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
dart_defines*.json
!dart_defines.example.json
secrets.json
**/secrets/
key.properties
**/*.keystore
**/*.jks
*.p8
*.p12
*.pem
*.key
*.mobileprovision
*.cer
google-services.json
GoogleService-Info.plist
sentry.properties
.sentryclirc
**/local.properties

# Profiling output (large raw traces; summaries live in docs/)
/benchmark_output/
*.perfetto-trace
